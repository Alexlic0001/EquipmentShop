@model EquipmentShop.Controllers.AccountController.UserOrderDetailsViewModel
@using EquipmentShop.Core.Enums
@{
    ViewData["Title"] = $"Заказ {Model.OrderNumber}";
    Layout = "_Layout";

    var canCancel = Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Processing;
    var within30Minutes = (DateTime.UtcNow - Model.OrderDate).TotalMinutes <= 30;
    var showCancelButton = canCancel && within30Minutes;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Profile">Профиль</a></li>
            <li class="breadcrumb-item"><a asp-action="Orders">Мои заказы</a></li>
            <li class="breadcrumb-item active">@Model.OrderNumber</li>
        </ol>
    </nav>

    <h2>Заказ @Model.OrderNumber</h2>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Позиции заказа</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Товар</th>
                                <th>Кол-во</th>
                                <th>Цена</th>
                                <th>Итого</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@($"{item.Price:N0} р.")</td>
                                    <td>@($"{item.Total:N0} р.")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Информация о заказе</h5>
                </div>
                <div class="card-body">
                    <p><strong>Дата:</strong> @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                    <p>
                        <strong>Статус:</strong>
                        @switch (Model.Status)
                        {
                            case OrderStatus.Pending:
                                <span class="badge bg-info">Ожидает обработки</span>
                                break;
                            case OrderStatus.Processing:
                                <span class="badge bg-warning">В обработке</span>
                                break;
                            case OrderStatus.Delivered:
                                <span class="badge bg-success">Доставлен</span>
                                break;
                            case OrderStatus.Cancelled:
                                <span class="badge bg-danger">Отменён</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@Model.Status.ToString()</span>
                                break;
                        }
                    </p>
                    <hr />
                    <h6><strong>Адрес доставки:</strong></h6>
                    <p class="mb-1">@Model.ShippingAddress</p>
                    @if (!string.IsNullOrEmpty(Model.ShippingCity))
                    {
                        <p class="mb-1"><i class="fas fa-city me-2"></i>@Model.ShippingCity</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingRegion))
                    {
                        <p class="mb-1"><i class="fas fa-map me-2"></i>@Model.ShippingRegion</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingPostalCode))
                    {
                        <p class="mb-1"><i class="fas fa-mailbox me-2"></i>@Model.ShippingPostalCode</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingCountry))
                    {
                        <p class="mb-1"><i class="fas fa-globe me-2"></i>@Model.ShippingCountry</p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span class="h5 mb-0">Итого:</span>
                        <strong class="h5">@($"{Model.Total:N0} р.")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Кнопка отмены -->
    @if (showCancelButton)
    {
        <div class="mt-3">
            <form asp-action="CancelOrder" asp-controller="Account" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderNumber" value="@Model.OrderNumber" />
                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Вы уверены? Отмена возможна только в течение 30 минут после оформления.')">
                    <i class="fas fa-times-circle"></i> Отменить заказ
                </button>
            </form>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Orders" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Все заказы
        </a>
    </div>
</div>