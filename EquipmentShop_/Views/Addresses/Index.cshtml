@model List<EquipmentShop.Core.Entities.UserAddress>
@{
    ViewData["Title"] = "Мои адреса доставки";
    Layout = "_Layout";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile">Профиль</a></li>
            <li class="breadcrumb-item active">Адреса доставки</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Мои адреса доставки</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Добавить адрес
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> У вас пока нет сохранённых адресов доставки.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var (address, index) in Model.Select((value, i) => (value, i)))
            {
                <div class="col-md-6 mb-3">
                    <div class="card @(address.IsDefault ? "border-primary" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title mb-0">@address.Title</h5>
                                @if (address.IsDefault)
                                {
                                    <span class="badge bg-primary">Основной</span>
                                }
                            </div>
                            <p class="card-text">
                                <i class="fas fa-map-marker-alt text-muted me-2"></i>@address.FullAddress<br>
                                @if (!string.IsNullOrEmpty(address.PostalCode))
                                {
                                    <span><i class="fas fa-mailbox text-muted me-2"></i>@address.PostalCode</span>
                        
                                    <br>
                                }
                                @if (!string.IsNullOrEmpty(address.Phone))
                                {
                                    <span><i class="fas fa-phone text-muted me-2"></i>@address.Phone</span>
                        
                                    <br>
                                }
                                @if (!string.IsNullOrEmpty(address.FullName))
                                {
                                    <span><i class="fas fa-user text-muted me-2"></i>@address.FullName</span>
                                }
                            </p>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-index="@index" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Редактировать
                                </a>
                                <form asp-action="Delete" asp-route-index="@index" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Удалить этот адрес?')">
                                        <i class="fas fa-trash"></i> Удалить
                                    </button>
                                </form>
                                @if (!address.IsDefault)
                                {
                                    <form asp-action="SetDefault" asp-route-index="@index" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-star"></i> Сделать основным
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Назад в профиль
        </a>
    </div>
</div>