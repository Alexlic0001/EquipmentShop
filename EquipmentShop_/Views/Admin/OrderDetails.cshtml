@using EquipmentShop.Core.Enums
@using EquipmentShop.Core.Constants
@model EquipmentShop.Core.Entities.Order
@{
    ViewData["Title"] = $"Заказ {Model.OrderNumber}";
    Layout = "_Layout";

    var canCancel = Model.Status != OrderStatus.Delivered &&
                    Model.Status != OrderStatus.Refunded &&
                    Model.Status != OrderStatus.Cancelled;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Dashboard">Админ-панель</a></li>
            <li class="breadcrumb-item"><a asp-action="Orders">Заказы</a></li>
            <li class="breadcrumb-item active" aria-current="page">Заказ @Model.OrderNumber</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Товары в заказе</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Цена</th>
                                <th>Количество</th>
                                <th>Сумма</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.UnitPrice.ToString("N0")@AppConstants.CurrencySymbol</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.TotalPrice.ToString("N0")@AppConstants.CurrencySymbol</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end"><strong>Итого:</strong></td>
                                <td><strong>@Model.Total.ToString("N0")@AppConstants.CurrencySymbol</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Информация о заказе</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Номер:</strong></td>
                            <td>@Model.OrderNumber</td>
                        </tr>
                        <tr>
                            <td><strong>Клиент:</strong></td>
                            <td>@Model.CustomerName</td>
                        </tr>
                        <tr>
                            <td><strong>Email:</strong></td>
                            <td>@Model.CustomerEmail</td>
                        </tr>
                        <tr>
                            <td><strong>Телефон:</strong></td>
                            <td>@Model.CustomerPhone</td>
                        </tr>
                        <tr>
                            <td><strong>Статус:</strong></td>
                            <td>
                                @switch (Model.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-info">Ожидает обработки</span>
                                        break;
                                    case OrderStatus.Processing:
                                        <span class="badge bg-warning">В обработке</span>
                                        break;
                                    case OrderStatus.Delivered:
                                        <span class="badge bg-success">Доставлен</span>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">Отменён</span>
                                        break;
                                    case OrderStatus.Refunded:
                                        <span class="badge bg-secondary">Возврат</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@Model.Status.ToString()</span>
                                        break;
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Дата:</strong></td>
                            <td>@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Адрес доставки</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                    {
                        <p class="mb-1"><i class="fas fa-map-marker-alt me-2"></i>@Model.ShippingAddress</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingCity))
                    {
                        <p class="mb-1"><i class="fas fa-city me-2"></i>@Model.ShippingCity</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingRegion))
                    {
                        <p class="mb-1"><i class="fas fa-map me-2"></i>@Model.ShippingRegion</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingPostalCode))
                    {
                        <p class="mb-1"><i class="fas fa-mailbox me-2"></i>@Model.ShippingPostalCode</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShippingCountry))
                    {
                        <p class="mb-1"><i class="fas fa-globe me-2"></i>@Model.ShippingCountry</p>
                    }
                    @if (string.IsNullOrEmpty(Model.ShippingAddress) &&
                                        string.IsNullOrEmpty(Model.ShippingCity) &&
                                        string.IsNullOrEmpty(Model.ShippingRegion))
                    {
                        <p class="text-muted mb-0">Адрес не указан</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Кнопки действий -->
    <div class="mt-3">
        @if (canCancel)
        {
            <form asp-action="CancelOrder" asp-controller="Admin" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Вы уверены, что хотите отменить заказ?')">
                    <i class="fas fa-times-circle"></i> Отменить заказ
                </button>
            </form>
        }
        <a asp-action="Orders" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Назад к списку
        </a>
    </div>
</div>