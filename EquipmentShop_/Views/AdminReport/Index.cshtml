@using EquipmentShop.Core.ViewModels.Admin
@using EquipmentShop.Core.Entities
@using EquipmentShop.Core.Constants
@using EquipmentShop.Core.Enums

@model EquipmentShop.Core.ViewModels.Admin.SalesReportFilterViewModel
@{
    ViewData["Title"] = "Отчеты по продажам";
    Layout = "_Layout";

    // Безопасное извлечение данных из ViewBag
    var reportData = ViewBag.ReportData as List<SalesReportViewModel>;
    var categories = ViewBag.Categories as List<Category>;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Админ-панель</a></li>
            <li class="breadcrumb-item active">Отчеты по продажам</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-chart-line"></i> Отчеты по продажам</h1>
        <div class="btn-group">
            <a asp-action="ExportToCsv"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-brand="@Model.Brand"
               class="btn btn-success">
                <i class="fas fa-file-csv"></i> Экспорт CSV
            </a>
            <a asp-action="ExportSummaryCsv"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               class="btn btn-info">
                <i class="fas fa-file-alt"></i> Сводка CSV
            </a>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Фильтры</h5>
        </div>
        <div class="card-body">
            <form asp-action="GenerateReport" method="post" id="reportForm">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Дата с</label>
                        <input type="date" asp-for="StartDate" class="form-control" id="startDate" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Дата по</label>
                        <input type="date" asp-for="EndDate" class="form-control" id="endDate" />
                    </div>
                    @* <div class="col-md-3 mb-3">
                        <label class="form-label">Категория</label>
                        <select asp-for="CategoryId" class="form-select" id="categoryId">
                            <option value="">Все категории</option>
                            @if (categories != null)
                            {
                                foreach (var cat in categories)
                                {
                                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">
                                        @cat.Name
                                    </option>
                                }
                            }
                        </select>
                    </div> *@
                    @*  <div class="col-md-3 mb-3">
                        <label class="form-label">Бренд</label>
                        <input type="text" asp-for="Brand" class="form-control" id="brand"
                               placeholder="Например: ASUS" value="@Model.Brand" />
                    </div> *@
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Сортировка</label>
                        <select asp-for="SortBy" class="form-select">
                            <option value="TotalRevenue" selected="@(Model.SortBy == "TotalRevenue")">По выручке</option>
                            <option value="TotalQuantitySold" selected="@(Model.SortBy == "TotalQuantitySold")">По количеству</option>
                            <option value="ProductName" selected="@(Model.SortBy == "ProductName")">По названию</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Порядок</label>
                        <select asp-for="SortDescending" class="form-select">
                            <option value="true" selected="@(Model.SortDescending == true)">По убыванию</option>
                            <option value="false" selected="@(Model.SortDescending == false)">По возрастанию</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-search"></i> Сформировать отчет
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-redo"></i> Сбросить
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Сводные показатели -->
    @if (ViewBag.TotalRevenue != null)
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h5>Общая выручка</h5>
                        <h3>@ViewBag.TotalRevenue.ToString("N0") р.</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h5>Продано товаров</h5>
                        <h3>@ViewBag.TotalQuantitySold шт.</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <h5>Уникальных товаров</h5>
                        <h3>@ViewBag.TotalProducts</h3>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 📊 ДИАГРАММЫ -->
    @if (ViewBag.TotalRevenue != null)
    {
        <div class="row mb-4">
            <!-- 📈 Линейный график выручки -->
            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-chart-line"></i> Динамика выручки</h5>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary active"
                                    data-group-by="month" onclick="switchGroupBy('month')">
                                По месяцам
                            </button>
                            <button type="button" class="btn btn-outline-primary"
                                    data-group-by="week" onclick="switchGroupBy('week')">
                                По неделям
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="revenueChart" height="100"></canvas>
                    </div>
                </div>
            </div>

            <!-- 🥧 Круговая диаграмма по категориям -->
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-chart-pie"></i> По категориям</h5>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Таблица отчета -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-table"></i> Детализация по товарам</h5>
        </div>
        <div class="card-body">
            @if (reportData != null && reportData.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <!-- 🔧 Настройка ширины колонок -->
                        <colgroup>
                            <col style="width: 22%;">  <!-- Товар -->
                            <col style="width: 12%;">  <!-- Категория -->
                            <col style="width: 10%;">  <!-- Бренд -->
                            <col style="width: 8%;">   <!-- Продано -->
                            <col style="width: 7%;">   <!-- Заказов -->
                            <col style="width: 13%;">  <!-- Цена (шире) -->
                            <col style="width: 15%;">  <!-- Выручка (шире) -->
                            <col style="width: 13%;">  <!-- Средний чек -->
                            <col style="width: 10%;">  <!-- Первая продажа -->
                            <col style="width: 10%;">  <!-- Последняя продажа -->
                            <col style="width: 8%;">   <!-- Статус -->
                        </colgroup>
                        <thead class="table-dark">
                            <tr>
                                <th>Товар</th>
                                <th>Категория</th>
                                <th>Бренд</th>
                                <th class="text-end">Продано (шт)</th>
                                <th class="text-end">Заказов</th>
                                <th class="text-end">Цена</th>
                                <th class="text-end">Выручка</th>
                                <th class="text-end">Средний чек</th>
                                <th>Первая продажа</th>
                                <th>Последняя продажа</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in reportData)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.ProductName</strong><br>
                                        <small class="text-muted">@item.ProductSku</small>
                                    </td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.Brand</td>
                                    <td class="text-end fw-bold">@item.TotalQuantitySold</td>
                                    <td class="text-end">@item.OrderCount</td>
                                    <!-- 🔧 Цена: запрет переноса -->
                                    <td class="text-end" style="white-space: nowrap;">@item.UnitPrice.ToString("N0") р.</td>
                                    <!-- 🔧 Выручка: запрет переноса -->
                                    <td class="text-end fw-bold text-primary" style="white-space: nowrap;">@item.TotalRevenue.ToString("N0") р.</td>
                                    <!-- 🔧 Средний чек: тоже защищаем от переноса -->
                                    <td class="text-end" style="white-space: nowrap;">@item.AverageOrderValue.ToString("N0") р.</td>
                                    <td>@item.FirstSaleDate.ToString("dd.MM.yyyy")</td>
                                    <td>@item.LastSaleDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (item.Status == "Активен")
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Итого:</td>
                                <td class="text-end fw-bold">@reportData.Sum(r => r.TotalQuantitySold)</td>
                                <td class="text-end">@reportData.Sum(r => r.OrderCount)</td>
                                <td>-</td>
                                <!-- 🔧 Итоговая выручка: запрет переноса -->
                                <td class="text-end fw-bold text-primary" style="white-space: nowrap;">@reportData.Sum(r => r.TotalRevenue).ToString("N0") р.</td>
                                <td>-</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else if (ViewBag.TotalRevenue != null)
            {
                <!-- Отчет сформирован, но данных нет -->
                <div class="text-center text-muted py-5">
                    <i class="fas fa-inbox fa-4x mb-3"></i>
                    <h5>Нет данных за выбранный период</h5>
                    <p class="mb-0">Попробуйте изменить параметры фильтра или период дат</p>
                </div>
            }
            else
            {
                <!-- Отчет ещё не сформирован -->
                <div class="text-center text-muted py-5">
                    <i class="fas fa-chart-bar fa-4x mb-3"></i>
                    <h5>Выберите параметры и нажмите "Сформировать отчет"</h5>
                    <p class="mb-0">Данные о продажах появятся здесь после генерации отчета</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js  "></script>

    <script>
        let revenueChart;
        let categoryChart;
        let currentGroupBy = 'month';

        document.addEventListener('DOMContentLoaded', function() {
            // Установка дат по умолчанию (последние 30 дней)
            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');
            const today = new Date();
            const thirtyDaysAgo = new Date();
            thirtyDaysAgo.setDate(today.getDate() - 30);

            if (startDateInput && !startDateInput.value) {
                startDateInput.value = thirtyDaysAgo.toISOString().split('T')[0];
            }
            if (endDateInput && !endDateInput.value) {
                endDateInput.value = today.toISOString().split('T')[0];
            }

            // Инициализация графиков только если есть данные
            @if (ViewBag.TotalRevenue != null)
            {
                        <text>
                        initializeRevenueChart();
                        initializeCategoryChart();
                        loadRevenueData();
                        loadCategoryData();
                        </text>
            }

            // Обновление графиков при отправке формы
            document.getElementById('reportForm')?.addEventListener('submit', function() {
                setTimeout(() => {
                    @if (ViewBag.TotalRevenue != null)
                    {
                                <text>
                                loadRevenueData();
                                loadCategoryData();
                                </text>
                    }
                }, 500);
            });
        });

        // 🔄 Переключение группировки (недели/месяцы)
        function switchGroupBy(groupBy) {
            currentGroupBy = groupBy;
            document.querySelectorAll('[data-group-by]').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.groupBy === groupBy);
            });
            loadRevenueData();
        }

        // 📈 Инициализация линейного графика
        function initializeRevenueChart() {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Выручка (р.)',
                        data: [],
                        borderColor: 'rgb(111, 25, 181)',
                        backgroundColor: 'rgba(111, 25, 181, 0.1)',
                        tension: 0.4,
                        fill: true,
                        yAxisID: 'y'
                    }, {
                        label: 'Заказы',
                        data: [],
                        borderColor: 'rgb(40, 167, 69)',
                        backgroundColor: 'rgba(40, 167, 69, 0.1)',
                        tension: 0.4,
                        fill: true,
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    let label = ctx.dataset.label + ': ';
                                    label += new Intl.NumberFormat('ru-BY').format(ctx.parsed.y);
                                    if (ctx.datasetIndex === 0) label += ' р.';
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: { display: true, text: 'Выручка (р.)' },
                            ticks: {
                                callback: function(value) {
                                    return new Intl.NumberFormat('ru-BY', { notation: 'compact' }).format(value) + ' р.';
                                }
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: { display: true, text: 'Заказы' },
                            grid: { drawOnChartArea: false }
                        }
                    }
                }
            });
        }

        // 🥧 Инициализация круговой диаграммы
        function initializeCategoryChart() {
            const ctx = document.getElementById('categoryChart').getContext('2d');
            categoryChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [],
                    datasets: [{
                        data: [],
                        backgroundColor: [
                            '#6f19b5', '#28a745', '#dc3545', '#ffc107', '#17a2b8',
                            '#6c757d', '#fd7e14', '#20c997', '#e83e8c', '#6610f2'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } },
                        tooltip: {
                            callbacks: {
                                label: function(ctx) {
                                    const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                    const percent = ((ctx.parsed / total) * 100).toFixed(1);
                                    return `${ctx.label}: ${new Intl.NumberFormat('ru-BY').format(ctx.parsed)} р. (${percent}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 📥 Загрузка данных для линейного графика
        async function loadRevenueData() {
            try {
                const startDate = document.getElementById('startDate')?.value || '';
                const endDate = document.getElementById('endDate')?.value || '';

                const response = await fetch(
                    `/admin/reports/chart-data?groupBy=${currentGroupBy}&startDate=${startDate}&endDate=${endDate}`
                );
                const data = await response.json();

                if (data.error) { console.error(data.error); return; }

                revenueChart.data.labels = data.labels;
                revenueChart.data.datasets[0].data = data.revenue;
                revenueChart.data.datasets[1].data = data.orders;
                revenueChart.update();
            } catch (error) {
                console.error('Ошибка загрузки данных графика:', error);
            }
        }

        // 📥 Загрузка данных для круговой диаграммы
        async function loadCategoryData() {
            try {
                const startDate = document.getElementById('startDate')?.value || '';
                const endDate = document.getElementById('endDate')?.value || '';

                const response = await fetch(
                    `/admin/reports/category-chart-data?startDate=${startDate}&endDate=${endDate}`
                );
                const data = await response.json();

                if (data.error) { console.error(data.error); return; }

                categoryChart.data.labels = data.map(d => d.category);
                categoryChart.data.datasets[0].data = data.map(d => d.revenue);
                categoryChart.update();
            } catch (error) {
                console.error('Ошибка загрузки данных категорий:', error);
            }
        }
    </script>
}