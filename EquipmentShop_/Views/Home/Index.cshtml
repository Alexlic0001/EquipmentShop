@{
    ViewData["Title"] = "Главная";
}

<!-- Hero Banner -->
<div class="bg-primary text-white py-5 mb-5 rounded-3 shadow"
     style="background-color: #6f19b5 !important;">
    <div class="container text-center">
        <h1 class="display-5 fw-bold">ПрофСистемы Безопасности</h1>
        <p class="lead">Системы видеонаблюдения, СКУД, периметральная техника и многое другое — в наличии и под заказ</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-light btn-lg mt-3 px-4">
            <i class="fas fa-shopping-bag me-2"></i>Перейти в каталог
        </a>
    </div>
</div>

<!-- Персонализированные рекомендации (ТОЛЬКО для авторизованных) -->
@if (ViewBag.Personalized != null)
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4">Рекомендуем лично вам</h2>
            <a asp-controller="Products" asp-action="Index" class="text-decoration-none">Все товары →</a>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var p in ViewBag.Personalized)
            {
                <div class="col">
                    <partial name="_ProductCard" model="p" />
                </div>
            }
        </div>
    </section>
}

<!-- Рекомендуемые -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4">Рекомендуем</h2>
        <a asp-controller="Products" asp-action="Index" asp-route-isFeatured="true" class="text-decoration-none">Все →</a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in ViewBag.Featured)
        {
            <div class="col">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>
</section>

<!-- Новинки -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4">Новинки</h2>
        <a asp-controller="Products" asp-action="Index" asp-route-isNew="true" class="text-decoration-none">Все →</a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in ViewBag.NewArrivals)
        {
            <div class="col">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>
</section>

<!-- Бестселлеры -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4">Популярные товары</h2>
        <a asp-controller="Products" asp-action="Index" asp-route-sortBy="popular" class="text-decoration-none">Все →</a>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in ViewBag.Bestsellers)
        {
            <div class="col">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>
</section>

