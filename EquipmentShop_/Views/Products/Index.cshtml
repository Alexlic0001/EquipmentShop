@using EquipmentShop.Core.Constants
@model IEnumerable<EquipmentShop.Core.Entities.Product>
@{
    ViewData["Title"] = "Каталог товаров";

    // Группируем товары по категориям
    var productsByCategory = Model
        .GroupBy(p => p.CategoryId)
        .ToDictionary(g => g.Key, g => g.ToList());

    // Получаем категории для отображения названий
    var categories = ViewBag.Categories as List<EquipmentShop.Core.Entities.Category> ?? new List<EquipmentShop.Core.Entities.Category>();
}

<div class="container mt-4">
    <h1>Каталог товаров</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">
            Товары не найдены
        </div>
    }
    else
    {
        @foreach (var categoryId in productsByCategory.Keys)
        {
            var category = categories.FirstOrDefault(c => c.Id == categoryId);
            var categoryName = category?.Name ?? "Без категории";
            var collapseId = $"collapse-{categoryId}";
            var cardId = $"card-{categoryId}";

            <div class="card mb-3" id="@cardId">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@categoryName</h5>
                    <button class="btn btn-sm btn-link text-dark p-0"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="true"
                            aria-controls="@collapseId">
                        <i class="toggle-icon fas fa-chevron-up"></i>
                    </button>
                </div>
                <div id="@collapseId" class="collapse show" data-parent="#@cardId">
                    <div class="card-body">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                            @foreach (var product in productsByCategory[categoryId])
                            {
                                <div class="col">
                                    <div class="card h-100 shadow-sm">
                                        <!-- Бейджи товара -->
           
                                        @if (product.IsNew)
                                        {
                                            <div class="position-absolute top-0 start-0 bg-success text-white px-2 py-1 small">
                                                <i class="fas fa-sparkles"></i> Новинка
                                            </div>
                                        }

                                        <!-- Кнопка избранного -->
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <div class="position-absolute top-0 end-0 p-2" style="z-index: 10;">
                                                <button class="btn btn-sm btn-outline-danger wishlist-btn"
                                                        data-product-id="@product.Id"
                                                        title="Добавить в избранное"
                                                        onclick="toggleWishlist(@product.Id, this)">
                                                    <i class="far fa-heart"></i>
                                                </button>
                                            </div>
                                        }

                                        <img src="@product.ImageUrl" class="card-img-top p-3" alt="@product.Name"
                                             style="height: 200px; object-fit: contain;">

                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <a asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark">
                                                    @product.Name
                                                </a>
                                            </h5>

                                            <div class="mb-2">
                                                <span class="h5 text-primary">@product.Price.ToString("N0")@AppConstants.CurrencySymbol</span>
                                         
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="badge @(product.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                                                    @(product.StockQuantity > 0 ? "В наличии" : "Нет в наличии")
                                                </span>
                                            </div>
                                        </div>

                                        <div class="card-footer bg-transparent border-top-0">
                                            <a asp-action="Details" asp-route-id="@product.Id"
                                               class="btn btn-primary w-100">Подробнее</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Обработка кнопок сворачивания/разворачивания
            document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
                const target = button.getAttribute('data-bs-target');
                const collapse = document.querySelector(target);

                // Устанавливаем начальное состояние иконки
                updateIcon(button, collapse.classList.contains('show'));

                button.addEventListener('click', function () {
                    setTimeout(() => {
                        const isExpanded = collapse.classList.contains('show');
                        updateIcon(this, isExpanded);
                    }, 10);
                });
            });

            // Проверка состояния избранного для всех товаров на странице
            updateWishlistState();

            function updateIcon(button, isExpanded) {
                const icon = button.querySelector('.toggle-icon');
                if (icon) {
                    icon.className = 'toggle-icon fas ' + (isExpanded ? 'fa-chevron-up' : 'fa-chevron-down');
                }
            }
        });

        // Обновление состояния всех кнопок избранного на странице
        async function updateWishlistState() {
            if (!@Html.Raw(User.Identity?.IsAuthenticated == true ? "true" : "false")) return;

            const wishlistButtons = document.querySelectorAll('.wishlist-btn');
            for (const button of wishlistButtons) {
                const productId = button.dataset.productId;
                try {
                    const response = await fetch(`@Url.Action("Check", "Wishlist")?productId=${productId}`);
                    if (response.ok) {
                        const data = await response.json();
                        const icon = button.querySelector('i');
                        if (data.isInWishlist) {
                            button.classList.remove('btn-outline-danger');
                            button.classList.add('btn-danger');
                            icon.classList.remove('far', 'fa-heart');
                            icon.classList.add('fas', 'fa-heart');
                            button.title = 'Удалить из избранного';
                        }
                    }
                } catch (error) {
                    console.error('Ошибка проверки избранного:', error);
                }
            }
        }
    </script>
}