@model EquipmentShop.Core.Entities.Product

<div class="card h-100 shadow-sm border-0 product-card">
    <!-- Бейджи товара -->
    @if (Model.OldPrice.HasValue && Model.OldPrice > Model.Price)
    {
        <div class="position-absolute top-0 end-0 bg-danger text-white px-2 py-1 small">
            <i class="fas fa-tag"></i> Акция
        </div>
    }
    @if (Model.IsNew)
    {
        <div class="position-absolute top-0 start-0 bg-success text-white px-2 py-1 small">
            <i class="fas fa-sparkles"></i> Новинка
        </div>
    }
    @if (Model.StockQuantity > 0 && Model.StockQuantity <= 5)
    {
        <div class="position-absolute top-100 start-0 translate-middle-y bg-warning text-dark px-2 py-1 small" style="font-size: 0.75rem;">
            <i class="fas fa-exclamation-triangle"></i> Последние @Model.StockQuantity шт.
        </div>
    }

    <!-- Кнопка избранного (улучшенная версия) -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="position-absolute top-0 end-0 p-2" style="z-index: 10;">
            <button class="btn btn-sm btn-outline-danger wishlist-btn"
                    data-product-id="@Model.Id"
                    title="Добавить в избранное"
                    onclick="toggleWishlist(@Model.Id, this)">
                <i class="far fa-heart"></i>
            </button>
        </div>
    }

    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">
        <div class="card-img-container" style="height: 160px; display: flex; align-items: center; justify-content: center; padding: 1rem;">
            @if (Model.StockQuantity <= 0)
            {
                <div class="position-absolute" style="top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 5;">
                    <span class="badge bg-danger fs-6 p-3">
                        <i class="fas fa-times-circle"></i> Нет в наличии
                    </span>
                </div>
            }
            <img src="@Model.ImageUrl"
                 class="img-fluid"
                 alt="@Model.Name"
                 style="max-height: 140px; max-width: 100%; object-fit: contain;"
                 onerror="this.onerror=null; this.src='/images/products/default.jpg';">
        </div>

        <div class="card-body d-flex flex-column">
            <h6 class="card-title fw-normal mb-2" style="min-height: 40px;">
                @Model.Name
            </h6>

            <div class="mt-auto">
                <!-- Цена -->
                <div class="mb-2">
                    <span class="h6 text-primary fw-bold">@($"{Model.Price:N0} р.")</span>
                    @if (Model.OldPrice.HasValue)
                    {
                        <br>
                        <small class="text-muted text-decoration-line-through">@($"{Model.OldPrice:N0} р.")</small>
                        <small class="text-success d-block">
                            <i class="fas fa-arrow-down"></i> Экономия @($"{(Model.OldPrice.Value - Model.Price):N0} р.")
                        </small>
                    }
                </div>

                <!-- Статус наличия -->
                <div class="mb-2">
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="badge bg-success">
                            <i class="fas fa-check-circle"></i> В наличии
                        </span>
                        @if (Model.StockQuantity <= Model.MinStockThreshold)
                        {
                            <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
                                Осталось: @Model.StockQuantity шт.
                            </small>
                        }
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            <i class="fas fa-times-circle"></i> Нет в наличии
                        </span>
                    }
                </div>
            </div>
        </div>
    </a>

    <div class="card-footer bg-transparent border-0 pb-3">
        @if (Model.StockQuantity > 0)
        {
            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-grid gap-2">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="quantity" value="1" />
                <button type="submit" class="btn btn-primary btn-sm w-100" title="Добавить в корзину">
                    <i class="fas fa-cart-plus me-1"></i> В корзину
                </button>
            </form>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                <i class="fas fa-ban me-1"></i> Нет в наличии
            </button>
        }
    </div>
</div>